# ============================================================
# RAG System — Environment Variables (template)
# Copy to `.env` and fill in real values for local dev.
# `.env` is gitignored; never commit real secrets.
# ============================================================

# --- Runtime ---
ENV=dev                              # dev | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Auth (Layer 9) ---
# Generate random strings for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN_SECRET=change-me-to-random-string
ADMIN_TOKEN=change-me-to-random-string

# --- Milvus ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunks
MILVUS_INDEX_VERSION=1                # part of cache key; bump on schema change

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin           # default for local docker; change in prod
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_USE_SSL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- LLM provider switch ---
# vertex   = Google Vertex Gemini (needs VERTEX_* + GOOGLE_APPLICATION_CREDENTIALS)
# deepseek = DeepSeek API         (needs DEEPSEEK_API_KEY)
LLM_PROVIDER=deepseek

# --- Vertex AI (Gemini) ---
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_GENERATION_MODEL=gemini-2.5-flash
VERTEX_JUDGE_MODEL=gemini-2.5-pro
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json   # absolute path to your GCP service account JSON

# --- DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_JUDGE_MODEL=deepseek-reasoner

# --- Local models ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODEL_CACHE_DIR=./.model_cache

# --- Retrieval ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0
RETRIEVAL_NEIGHBOR_WINDOW=2           # 0 disables; ±N adjacent chunks per hit

# --- Cache TTL (seconds) ---
EMB_CACHE_TTL=86400                   # 24h
RET_CACHE_TTL=1800                    # 30m

# --- Feature flags ---
FEATURE_MULTI_QUERY=false             # P0: default off; turn on after eval evidence

# --- Cost limits ---
LLM_DAILY_USER_TOKEN_LIMIT=200000
LLM_DAILY_SESSION_TOKEN_LIMIT=50000

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- PDF parsing ---
# Force OCR on every PDF page (bypasses PyMuPDF text extraction). Slower
# but works around PDFs whose text layer silently drops content (broken
# CMap fonts, bullet-list bold headers).
PDF_FORCE_OCR=false

# --- LlamaParse (premium PDF parser, optional) ---
# When set, PDFs go to LlamaParse first (layout-aware Markdown output).
# Falls back to local PyMuPDF + OCR on error or when this is empty.
# Get a key at https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=

# --- Document versioning ---
DOC_VERSIONS_KEEP=3                   # keep last N versions of each doc_id

# --- Session ---
SESSION_HISTORY_TURNS=5
SESSION_TTL=86400
