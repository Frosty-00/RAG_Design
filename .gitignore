# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*-credentials*.json
**/google-credentials*.json
# GCP service account JSONs commonly look like `{project-id}-{hash}.json`.
# This catches that pattern without false-positives on regular config:
service-account*.json
*service_account*.json
*-service-account*.json
secrets/
.secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# uv
.uv/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Docker volumes (mounted into containers)
volumes/

# Model cache
.model_cache/
.huggingface/

# Logs / tmp
*.log
.tmp/
.cache/

# Eval reports + datasets (both are per-installation runtime data)
eval/reports/*.json
eval/reports/*.md
!eval/reports/.gitkeep
eval/datasets/*.jsonl
!eval/datasets/.gitkeep

# Local dev binaries (downloaded tools, not project deps)
cloudflared.exe
*.exe

# Claude Code personal state
.claude/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
